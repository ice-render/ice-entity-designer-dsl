{
  "compilerOptions": {
    "target": "es6",
    "module": "esnext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": false,
    "declaration": true,
    "declarationDir": "dist/types",
    "skipLibCheck": true,
    "types": ["jest"]
  },
  "include": ["src"]
}
