{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ice-render-dsl document",
  "type": "object",
  "required": ["entities"],
  "properties": {
    "schemaVersion": { "type": "number" },
    "layout": {
      "type": "string",
      "enum": ["grid", "layered", "horizontal", "vertical"]
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "entityName": { "type": "string" },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "length": { "type": ["number", "string"] }
              }
            }
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" },
          "type": { "type": "string" },
          "relationType": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": true
}
